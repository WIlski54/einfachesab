# Pflicht
LEHRER_PASSWORD=sicheres-passwort          # Passwort der Lehrkraft (Dashboard, Tafel)
SECRET_KEY=langer-zufaelliger-string       # signiert die Sitzungen; z. B.: python -c "import secrets; print(secrets.token_hex(32))"

# Optional
# AUTO_LOESCHEN_STUNDEN=4                  # alle Daten nach so vielen Stunden ohne Aktivität löschen (Standard 4)
# KI_API_KEY=                              # schaltet die KI-Lernhilfe frei (ohne Key: keine KI)
# KI_PROVIDER=anthropic                    # anthropic (Standard) oder gemini
# KI_MODEL=                                # leer = Standardmodell des Anbieters
# CORS_ORIGINS=https://einfachesab.wilski.tech   # nur nötig, wenn Seite und Socket von verschiedenen Domains kommen
# PORT=5000                                # nur für lokalen Start (python app.py); im Container immer 5000
